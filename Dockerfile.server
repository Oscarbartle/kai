FROM python:3.13-slim

WORKDIR /app

COPY requirements-server.txt ./
RUN pip install --no-cache-dir -r requirements-server.txt

COPY kai/ ./kai/

# KAI_DATA_DIR must point to the mounted volume containing your JSON files.
ENV KAI_DATA_DIR=/data
ENV KAI_HOST=0.0.0.0
ENV KAI_PORT=8000

EXPOSE 8000

CMD ["python", "-m", "kai.server"]
