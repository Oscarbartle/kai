# Copy to `.env` (same directory) and fill in real values. `.env` is
# gitignored — never commit it.

# Password for the `kai` Postgres role docker-compose creates. Pick your own;
# only used inside the docker network between kai-server and postgres.
POSTGRES_PASSWORD=

# The token the desktop app must send as `Authorization: Bearer <token>` on
# every request. Generate one, e.g.:
#   openssl rand -hex 32
KAI_SHARED_TOKEN=

# Only needed if running kai-server directly (`cargo run -p kai-server`)
# rather than through docker-compose, which sets this itself from the two
# values above.
# DATABASE_URL=postgres://kai:${POSTGRES_PASSWORD}@localhost:5432/kai
